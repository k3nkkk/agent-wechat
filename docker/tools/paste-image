#!/bin/bash
# Paste an image file via clipboard
# Usage: paste-image <file-path> [mime-type]

set -euo pipefail

if [ -z "${1:-}" ]; then
  echo "Usage: paste-image <file-path> [mime-type]" >&2
  exit 1
fi

FILE="$1"
MIME="${2:-image/png}"

if [ ! -f "$FILE" ]; then
  echo "File not found: $FILE" >&2
  exit 1
fi

# Delegate GIF to paste-file so Qt/Chromium uses text/uri-list (WeChat native animated sticker TYPE: 47)
if [ "${MIME:-}" = "image/gif" ] || [[ "${FILE,,}" == *.gif ]]; then
  exec /opt/tools/paste-file "$FILE"
fi

# A still-running xclip from an earlier paste owns the clipboard with the
# same MIME type; pasting before the new owner takes over would insert the
# previous image. Stop it first.
pkill -x xclip >/dev/null 2>&1 || true

# Copy image to clipboard (backgrounded — xclip blocks until
# the selection is consumed, so it must run in parallel with the paste)
xclip -selection clipboard -t "$MIME" -i < "$FILE" >/dev/null 2>&1 &

# Wait until our xclip owns the clipboard and offers the image (large
# files take a moment to be read), up to ~3s.
for _ in $(seq 1 30); do
  if xclip -selection clipboard -o -t TARGETS 2>/dev/null | grep -qx "$MIME"; then
    break
  fi
  sleep 0.1
done

# Paste using Ctrl+V (consumes the clipboard, letting xclip exit)
xdotool key ctrl+v

# Small delay after paste
sleep 0.1

echo "pasted: $FILE ($MIME)"
